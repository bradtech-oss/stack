apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: bradtech
  labels:
    app.kubernetes.io/name: postgres
    app.kubernetes.io/component: database
    app.kubernetes.io/part-of: bradtech-stack
type: Opaque
stringData:
  POSTGRES_USER: "brad"
  POSTGRES_PASSWORD: "CHANGE_ME_IN_PRODUCTION"
