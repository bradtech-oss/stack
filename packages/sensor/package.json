{
  "name": "@bradtech/sensor",
  "version": "0.5.0",
  "description": "Foundational sensor abstraction, conversion interfaces, registry and replay engine for Brad sensor converters",
  "author": "Olivier Lépine <olivier@lepine.fr>",
  "license": "AGPL-3.0-or-later",
  "copyright": "Copyright (C) 2026 Olivier Lépine",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bradtech-oss/stack.git",
    "directory": "packages/sensor"
  },
  "keywords": [
    "iot",
    "sensor",
    "telemetry",
    "agronomy",
    "agriculture",
    "brad",
    "quatrain",
    "replay-engine",
    "agpl-v3"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "HOWTO.md",
    "!**/*.test.ts"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "wbuild": "tsc --watch",
    "test": "bun test"
  },
  "dependencies": {
    "@bradtech/types": "workspace:*",
    "@quatrain/core": "^1.2.17"
  },
  "devDependencies": {
    "@tsconfig/recommended": "^1.0.1",
    "@types/node": "^22.10.1",
    "typescript": "^5.1.5"
  }
}
