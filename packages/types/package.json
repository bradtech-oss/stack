  "dependencies": {
    "shulk": "0.15.0"
  },
  "devDependencies": {
    "@tsconfig/recommended": "^1.0.1",
    "@types/node": "^22.10.1",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "test": "bun test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bradtech-oss/stack.git",
    "directory": "packages/types"
  }
