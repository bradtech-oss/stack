{
  "name": "@bradtech/ontologies",
  "version": "0.5.0",
  "description": "Open Knowledge Format (OKF v0.1) agricultural taxonomies, multilingual selectors, and open data cross-referencing engine",
  "author": "Olivier Lépine <olivier@lepine.fr>",
  "license": "AGPL-3.0-or-later",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./data": "./data/index.md"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "data",
    "src",
    "!**/*.test.ts",
    "!**/__tests__"
  ],
  "scripts": {
    "build": "bun run src/build.ts && tsc -p tsconfig.build.json",
    "test": "bun test"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "copyright": "Copyright (C) 2026 Olivier Lépine",
  "repository": {
    "type": "git",
    "url": "https://github.com/bradtech-oss/stack.git",
    "directory": "packages/ontologies"
  }
}
