{
  "name": "@bradtech/sensor-power",
  "version": "0.5.0",
  "description": "Li-Ion battery state-of-charge (SoC), brownout risk detection, and solar harvesting power telemetry converters",
  "author": "Olivier Lépine <olivier@lepine.fr>",
  "license": "AGPL-3.0-or-later",
  "copyright": "Copyright (C) 2026 Olivier Lépine",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bradtech-oss/stack.git",
    "directory": "packages/sensor-power"
  },
  "keywords": [
    "iot",
    "battery",
    "soc",
    "state-of-charge",
    "li-ion",
    "brownout-protection",
    "solar-harvesting",
    "mppt",
    "power-management",
    "brad",
    "agpl-v3"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "HOWTO.md",
    "!**/*.test.ts"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "wbuild": "tsc --watch",
    "test": "bun test"
  },
  "dependencies": {
    "@bradtech/sensor": "workspace:*"
  },
  "devDependencies": {
    "@tsconfig/recommended": "^1.0.1",
    "@types/node": "^22.10.1",
    "typescript": "^5.1.5"
  }
}
