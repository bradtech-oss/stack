{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bradtech.app/schemas/mdm_device.json",
  "archetypeId": "hardware.device",
  "name": "IoT Physical Device / Hardware System",
  "nature": "physical",
  "collection": "devices",
  "typeCollection": "device_types",
  "specGroupRefs": [
    { "key": "dimensions", "$ref": "@quatrain/mdm/groups/dimensions" },
    { "key": "vendor_info", "$ref": "@quatrain/mdm/groups/vendor_info" }
  ],
  "requiredProperties": ["dimensions", "vendor_info"],
  "jsonSchema": {
    "type": "object",
    "required": ["dimensions", "vendor_info"],
    "properties": {
      "dimensions": {
        "$ref": "@quatrain/mdm/groups/dimensions",
        "type": "object",
        "title": "Physical Dimensions & Enclosure Group",
        "description": "Inline physical dimension attributes and ingress protection rating",
        "required": ["unitSystem", "height", "width"],
        "properties": {
          "unitSystem": {
            "type": "string",
            "title": "Unit System",
            "enum": ["metric", "imperial"],
            "default": "metric"
          },
          "height": {
            "type": "number",
            "title": "Height (mm or inches)",
            "minimum": 0
          },
          "width": {
            "type": "number",
            "title": "Width (mm or inches)",
            "minimum": 0
          },
          "depth": {
            "type": "number",
            "title": "Depth (mm or inches)",
            "minimum": 0
          },
          "weight": {
            "type": "number",
            "title": "Weight (grams or lbs)",
            "minimum": 0
          },
          "enclosureRating": {
            "type": "string",
            "title": "Ingress Protection Rating",
            "enum": ["IP65", "IP66", "IP67", "IP68", "NONE"]
          }
        }
      },
      "vendor_info": {
        "$ref": "@quatrain/mdm/groups/vendor_info",
        "type": "object",
        "title": "Vendor Relationship & Product Lifecycle Group",
        "description": "Inline supplier link and manufacturing lifecycle status",
        "required": ["status"],
        "properties": {
          "vendorUri": {
            "type": "string",
            "title": "Vendor ObjectUri Reference",
            "pattern": "^vendors/[a-zA-Z0-9_-]+$"
          },
          "vendorSku": {
            "type": "string",
            "title": "Vendor Product SKU"
          },
          "status": {
            "type": "string",
            "title": "Lifecycle Status",
            "enum": ["ACTIVE", "EOL", "DISCONTINUED"],
            "default": "ACTIVE"
          },
          "releaseDate": {
            "type": "string",
            "title": "Market Release Date",
            "format": "date"
          },
          "eolDate": {
            "type": "string",
            "title": "End of Life Date",
            "format": "date"
          }
        }
      }
    }
  }
}
